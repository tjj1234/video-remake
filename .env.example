# 复制为 .env 或直接 export 到环境变量后运行 remake.py
# 获取 Key：https://powertokens.ai/zh-Hans/dashboard → 注册/登录 → 充值 → 创建 Key(sk-pt-xxxx)

POWERTOKENS_API_KEY=sk-pt-xxxx

# ---- 分析阶段 ----
REMAKE_ANALYZE_MODEL=deepseek-v4-pro   # 出 storyboard 的文本 LLM
REMAKE_VISION_MODEL=deepseek-v4-pro     # ② 视觉风格提取模型（需多模态；不支持图片会自动降级纯文本）

# ---- 生成阶段 ----
REMAKE_GEN_MODEL=wan3.0-video          # ① 普通分镜生成模型（默认最便宜且稳 $0.20/5s）
REMAKE_MOTION_MODEL=kling-v2-1-master   # ③ 动作迁移模型（需支持 --ref-video）
REMAKE_GEN_DURATION=5                   # 单镜头生成时长(秒)，需落在模型支持档位
REMAKE_RESOLUTION=720p                  # 生成分辨率

# ---- 路径 ----
PT_VIDEO_SCRIPT=C:\Users\admin\.workbuddy\skills\powertokens-video\scripts\pt_video.py
REMAKE_DURATION_GUESS=30                # 无 ffprobe 时假设的视频时长(秒)，用于均匀抽帧/切片
